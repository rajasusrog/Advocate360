rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isMemberOfChamber(chamberId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/chambers/$(chamberId)/members/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/chambers/$(chamberId)).data.ownerUid == request.auth.uid
      );
    }
    
    function isChamberOwner(chamberId) {
      return isSignedIn() && (
        get(/databases/$(database)/documents/chambers/$(chamberId)).data.ownerUid == request.auth.uid
      );
    }

    function isChamberSeniorOrOwner(chamberId) {
      return isChamberOwner(chamberId) || (
        isMemberOfChamber(chamberId) && (
          get(/databases/$(database)/documents/chambers/$(chamberId)/members/$(request.auth.uid)).data.role == 'CHAMBER_OWNER' ||
          get(/databases/$(database)/documents/chambers/$(chamberId)/members/$(request.auth.uid)).data.role == 'SENIOR_ADVOCATE'
        )
      );
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profile - Strict read/write to owned UID only
    // Prevent ordinary users from escalating role or changing chamberId after creation
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'chamberId'])
      );
      allow delete: if false;
    }

    // Chamber Root & Subcollections
    match /chambers/{chamberId} {
      allow read: if isMemberOfChamber(chamberId);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isChamberOwner(chamberId);

      // Members Subcollection - Strict privilege escalation prevention
      match /members/{memberUid} {
        allow read: if isMemberOfChamber(chamberId);
        allow create, update, delete: if isChamberOwner(chamberId);
      }

      // Cases Subcollection & Nested Subcollections
      match /cases/{caseId} {
        allow read: if isMemberOfChamber(chamberId);
        allow create, update: if isMemberOfChamber(chamberId);
        allow delete: if isChamberSeniorOrOwner(chamberId);

        match /{allSubcollections=**} {
          allow read, create, update: if isMemberOfChamber(chamberId);
          allow delete: if isChamberSeniorOrOwner(chamberId);
        }
      }

      // Clients Subcollection
      match /clients/{clientId} {
        allow read: if isMemberOfChamber(chamberId);
        allow create, update: if isMemberOfChamber(chamberId);
        allow delete: if isChamberSeniorOrOwner(chamberId);
      }

      // Documents Subcollection
      match /documents/{documentId} {
        allow read: if isMemberOfChamber(chamberId);
        allow create, update: if isMemberOfChamber(chamberId);
        allow delete: if isChamberSeniorOrOwner(chamberId);
      }

      // Evidence Subcollection
      match /evidence/{evidenceId} {
        allow read: if isMemberOfChamber(chamberId);
        allow create, update: if isMemberOfChamber(chamberId);
        allow delete: if isChamberSeniorOrOwner(chamberId);
      }

      // Hearings Subcollection
      match /hearings/{hearingId} {
        allow read, create, update: if isMemberOfChamber(chamberId);
        allow delete: if isChamberSeniorOrOwner(chamberId);
      }

      // Tasks Subcollection
      match /tasks/{taskId} {
        allow read, create, update: if isMemberOfChamber(chamberId);
        allow delete: if isChamberSeniorOrOwner(chamberId);
      }

      // Fees Subcollection - Restricted financial governance
      match /fees/{feeId} {
        allow read: if isMemberOfChamber(chamberId);
        allow create, update, delete: if isChamberSeniorOrOwner(chamberId);
      }

      // Time Logs Subcollection - Billing & Hours tracking
      match /timeLogs/{timeLogId} {
        allow read, create, update: if isMemberOfChamber(chamberId);
        allow delete: if isChamberSeniorOrOwner(chamberId);
      }

      // Invoices Subcollection - Invoicing & Financial management
      match /invoices/{invoiceId} {
        allow read, create, update: if isMemberOfChamber(chamberId);
        allow delete: if isChamberSeniorOrOwner(chamberId);
      }

      // Audit Logs Subcollection - Immutable Append Only
      match /auditLogs/{logId} {
        allow read: if isMemberOfChamber(chamberId);
        allow create: if isMemberOfChamber(chamberId);
        allow update, delete: if false;
      }
    }
  }
}

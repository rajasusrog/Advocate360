# GEMINI_API_KEY: Required for Gemini AI API calls (@google/genai SDK).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# EXTERNAL RETRIEVAL SERVICE: Optional legal database citation retrieval API.
# If unconfigured, legal research assistant labels output as "Unverified Research Suggestion".
LEGAL_RETRIEVAL_API_KEY=""

# E-SIGNATURE PROVIDER: Optional document signing integration (e.g. eSign / DocuSign API).
# If unconfigured, digital signature drawer displays "Not configured - Production signing disabled".
DOCUMENT_SIGNING_PROVIDER_KEY=""

# DISTRIBUTED QUEUE SERVICE: Optional Redis queue URL for multi-node background job processing.
# If unconfigured, background job engine uses durable in-memory / Firestore adapter.
JOB_QUEUE_REDIS_URL=""
